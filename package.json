{
  "name": "dsh-cascade-search",
  "version": "1.2.1",
  "description": "Three-level web-search fallback for DeepSeek Harness: tavily-proxy -> Querit -> DeepSeek official, with GUI configuration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryker0716/dsh-cascade-search.git"
  },
  "bugs": {
    "url": "https://github.com/Ryker0716/dsh-cascade-search/issues"
  },
  "homepage": "https://github.com/Ryker0716/dsh-cascade-search#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cascade": "./lib/cascade.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/cascade.js",
    "lib/config.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "test/cascade.test.js",
    "test/index.test.js",
    "test/config.test.js"
  ],
  "scripts": {
    "test": "node --test test/",
    "check": "node --check lib/index.js && node --check lib/cascade.js && node --check lib/config.js && node --check lib/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "cascade",
    "tavily",
    "querit"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
